# Local dev reads these from a .env file at the backend root (auto-loaded by core/config.py).

# Uvicorn bind port (uncommon by default to avoid clashes).
PORT=8723

# Where Claude Code stores its sessions. Defaults to ~/.claude/projects.
# CLAUDE_PROJECTS_DIR=

# Default permission mode for new chat sessions:
# default | acceptEdits | plan | dontAsk | bypassPermissions
DEFAULT_PERMISSION_MODE=default

# Pull the latest claude-agent-sdk on startup. Set to 0 for faster dev reloads.
AUTO_UPDATE_SDK=1
