# Optional settings, auto-loaded by core/config.py. A plain `python run.py`
# needs none of them. Drop the `.example` suffix on a copy of this file to use
# it; README.md has the full table with every variable and its default.

PORT=8723

# default | acceptEdits | plan | dontAsk | bypassPermissions | auto
DEFAULT_PERMISSION_MODE=bypassPermissions

# low | medium | high | xhigh | max
DEFAULT_EFFORT=xhigh

# opus | opus[1m] | sonnet | sonnet[1m] | haiku | default
DEFAULT_MODEL=opus[1m]

# Where Claude Code stores its sessions. Defaults to ~/.claude/projects.
# CLAUDE_PROJECTS_DIR=

# Everything the backend owns on disk. Defaults to backend/data.
# CCONNECT_DATA_DIR=

# Fallback cwd for chats started without picking a directory. Defaults to the
# parent of the backend folder.
# DEFAULT_CWD=

# Bearer token for public exposure, written back by run.py on the first
# `--expose` run. Private runs ignore it and stay auth-less.
# PUBLIC_ACCESS_TOKEN=

# Hostname your reverse proxy serves, for `--expose caddy`. Without it run.py
# derives <user>-<public-ip>.sslip.io, which only works on a public IP.
# PUBLIC_HOSTNAME=

# Key that unlocks the terminal, written back by run.py on first start and
# printed on every start. It is the only thing gating a shell on this machine.
# TERMINAL_ACCESS_KEY=
